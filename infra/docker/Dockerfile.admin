# Multi-stage build for the React + Vite admin panel.
#
# Build context is the REPOSITORY ROOT (see docker-compose.prod.yml), not
# apps/admin: the app declares "@dod/shared": "file:../../libs/shared/typescript"
# and that path is outside apps/admin, so `npm ci` inside a context limited to
# apps/admin failed with ENOENT on ../../libs/shared/typescript.
#
# Layout note: WORKDIR is /app, so "file:../../libs/shared/typescript" from
# package.json resolves to /libs/shared/typescript. The shared library is
# copied there to keep the lockfile's relative link valid.

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat curl
WORKDIR /app

# ─── deps stage ─────────────────────────────────────────────────
FROM base AS deps
COPY apps/admin/package.json apps/admin/package-lock.json ./
COPY libs/shared/typescript /libs/shared/typescript
# Full install: `tsc` and `vite` live in devDependencies and are required by
# `npm run build`, so --omit=dev must NOT be used here (the previous image
# installed production-only deps and then ran tsc, which failed).
RUN npm ci --include=dev

# ─── builder stage ──────────────────────────────────────────────
FROM base AS builder
WORKDIR /app

ARG VITE_API_URL=/admin-api
ARG VITE_APP_ENV=production

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_ENV=${VITE_APP_ENV}

COPY --from=deps /app/node_modules ./node_modules
COPY libs/shared/typescript /libs/shared/typescript
COPY apps/admin ./

RUN npm run build

# ─── runner stage (nginx to serve the SPA) ──────────────────────
FROM nginx:1.25-alpine AS runner

RUN apk add --no-cache curl

COPY --from=builder /app/dist /usr/share/nginx/html
COPY apps/admin/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
